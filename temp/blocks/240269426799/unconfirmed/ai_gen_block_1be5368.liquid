{% doc %}
  @prompt
    Add a WhatsApp contact field to the footer's brand information block. It should display a WhatsApp icon with a clickable link that opens a WhatsApp chat. The field should allow customization of the WhatsApp phone number (default: +91 7648946041). The link should open WhatsApp with the format https://wa.me/ followed by the number (without the + sign). Style it to match the existing footer design.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-whatsapp-contact-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-whatsapp-link-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: inherit;
    transition: opacity 0.2s ease;
  }

  .ai-whatsapp-link-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-whatsapp-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
    fill: currentColor;
  }

  .ai-whatsapp-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-whatsapp-icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.9 }}px;
      height: {{ block.settings.icon_size | times: 0.9 }}px;
    }

    .ai-whatsapp-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-whatsapp-contact-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.whatsapp_number != blank %}
    {% assign clean_number = block.settings.whatsapp_number | replace: '+', '' | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' %}
    <a
      href="https://wa.me/{{ clean_number }}"
      class="ai-whatsapp-link-{{ ai_gen_id }}"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Contact us on WhatsApp"
    >
      <svg
        class="ai-whatsapp-icon-{{ ai_gen_id }}"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
      <span class="ai-whatsapp-text-{{ ai_gen_id }}">
        {% if block.settings.display_text != blank %}
          {{ block.settings.display_text }}
        {% else %}
          {{ block.settings.whatsapp_number }}
        {% endif %}
      </span>
    </a>
  {% endif %}
</div>

{% schema %}
{
  "name": "WhatsApp contact",
  "settings": [
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp number",
      "default": "+91 7648946041",
      "info": "Include country code (e.g., +91 7648946041)"
    },
    {
      "type": "text",
      "id": "display_text",
      "label": "Display text",
      "placeholder": "WhatsApp: +91 7648946041",
      "info": "Leave blank to show the phone number"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    }
  ],
  "presets": [
    {
      "name": "WhatsApp contact"
    }
  ]
}
{% endschema %}
