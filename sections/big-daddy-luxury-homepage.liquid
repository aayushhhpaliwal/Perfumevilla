{% comment %}
  Big Daddy Luxury Perfume Homepage
  Premium Shopify OS 2.0 section with GSAP, ScrollTrigger, Lenis, AJAX ATC, sticky cart, FAQs, testimonials, story scroll, notes timeline, comparison slider, and CRO blocks.
  Add to: /sections/big-daddy-luxury-homepage.liquid
{% endcomment %}

{% liquid
  assign sid = section.id
  assign product = section.settings.product
  assign current_variant = product.selected_or_first_available_variant
  assign bottle_image = section.settings.bottle_image
  assign hero_bg_image = section.settings.hero_bg_image
  assign notes_image = section.settings.notes_image
  assign lifestyle_image = section.settings.lifestyle_image
  assign before_image = section.settings.before_image
  assign after_image = section.settings.after_image
  if bottle_image == blank and product.featured_image != blank
    assign bottle_image = product.featured_image
  endif
  if hero_bg_image == blank
    assign hero_bg_image = bottle_image
  endif
  if notes_image == blank
    assign notes_image = section.settings.hero_bg_image
  endif
  if lifestyle_image == blank
    assign lifestyle_image = bottle_image
  endif
%}

<section
  id="BigDaddyLuxury-{{ sid }}"
  class="bdp bdp-{{ sid }}"
  data-section-id="{{ sid }}"
  data-product-id="{{ product.id }}">
  {% if section.settings.enable_preloader %}
    <div class="bdp-preloader" aria-hidden="true">
      <div class="bdp-preloader__inner">
        <div class="bdp-preloader__logo">The Perfume Villa</div>
        <div class="bdp-preloader__product">BIG DADDY</div>
        <div class="bdp-preloader__bar">
          <span></span>
        </div>
        <div class="bdp-preloader__percent">0%</div>
      </div>
    </div>
  {% endif %}

  <div class="bdp-cursor" aria-hidden="true"></div>

  <div class="bdp-announcement" data-bd-anim>
    <div class="bdp-announcement__track">
      {% for i in (1..2) %}
        <span>Free shipping on prepaid orders</span>
        <span>COD available</span>
        <span>Luxury gift-ready packaging</span>
        <span>Limited launch offer ends in
          <b data-countdown>00:00:00</b>
        </span>
      {% endfor %}
    </div>
  </div>

  <div class="bdp-sticky-atc" data-sticky-atc>
    <div class="bdp-sticky-atc__product">
      {% if bottle_image != blank %}
        <img
          src="{{ bottle_image | image_url: width: 120 }}"
          width="60"
          height="60"
          alt="{{ product.title | default: 'Big Daddy perfume bottle' | escape }}"
          loading="lazy">
      {% endif %}
      <div>
        <strong>{{ product.title | default: 'BIG DADDY Eau de Parfum' }}</strong>
        <small>
          <span data-sticky-price>
            {% if product != blank %}
              {{ current_variant.price | money }}{% else %}50ML · Premium Perfume{% endif %}
          </span>
        </small>
      </div>
    </div>
    <button class="bdp-btn bdp-btn--gold bdp-btn--small" data-sticky-add>Buy Now</button>
  </div>

  <header class="bdp-hero" data-bd-section>
    <div class="bdp-hero__ambient" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
      <span></span>
      <span></span>
    </div>
    <div class="bdp-hero__smoke" aria-hidden="true"></div>
    <div class="bdp-hero__content">
      <p class="bdp-kicker bdp-split">The Perfume Villa</p>
      <h1 class="bdp-hero__title bdp-split">Own The Room Before You Enter</h1>
      <p class="bdp-hero__subtitle bdp-reveal-line">A fragrance crafted for those who lead with confidence.</p>
      <div class="bdp-hero__actions">
        <a
          href="#bdp-product-buy-{{ sid }}"
          class="bdp-btn bdp-btn--gold"
          data-magnetic>Shop Now</a>
        <a
          href="#bdp-fragrance-{{ sid }}"
          class="bdp-btn bdp-btn--ghost"
          data-magnetic>Discover The Fragrance</a>
      </div>
      <div class="bdp-hero__trust" data-bd-anim>
        <span>★★★★★ 4.9 Rating</span>
        <span>100,000+ Happy Customers</span>
        <span>24 Hour Long Lasting</span>
        <span>Free Shipping</span>
      </div>
    </div>

    <div class="bdp-hero__bottle-wrap" data-hero-bottle>
      <div class="bdp-ruby-glow"></div>
      <div class="bdp-light-sweep"></div>
      {% if bottle_image != blank %}
        <img
          class="bdp-hero__bottle"
          src="{{ bottle_image | image_url: width: 1200 }}"
          srcset="{{ bottle_image | image_url: width: 500 }} 500w, {{ bottle_image | image_url: width: 800 }} 800w, {{ bottle_image | image_url: width: 1200 }} 1200w"
          sizes="(max-width: 749px) 78vw, 44vw"
          width="900"
          height="900"
          alt="{{ product.title | default: 'Big Daddy luxury perfume bottle' | escape }}">
      {% else %}
        <div class="bdp-bottle-fallback">
          <small>The Perfume Villa</small>
          <b>BIG<br>DADDY</b>
          <em>50ML</em>
        </div>
      {% endif %}
    </div>
  </header>

  <section
    class="bdp-trust-strip"
    aria-label="Brand trust benefits"
    data-bd-section>
    <div class="bdp-marquee">
      <div class="bdp-marquee__track">
        {% assign trust_items = 'Dermatologically Tested|Long Lasting|Premium Oils|Luxury Packaging|Free Shipping|Secure Checkout|Easy Returns|Made in India|Cruelty Free' | split: '|' %}
        {% for loop_index in (1..2) %}
          {% for item in trust_items %}
            <span class="bdp-marquee__item">
              <i></i>
              {{ item }}</span>
          {% endfor %}
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="bdp-editorial bdp-pad" data-bd-section>
    <div class="bdp-section-head bdp-section-head--wide">
      <p class="bdp-kicker bdp-split">Why Big Daddy</p>
      <h2 class="bdp-h2 bdp-split">Built like a statement. Worn like confidence.</h2>
      <p class="bdp-muted bdp-reveal-line">Deep ruby intensity, a matte-black luxury label, and a bold masculine signature crafted to stay with you from first impression to final goodbye.</p>
    </div>
    <div class="bdp-feature-grid">
      {% assign feature_titles = '24 Hours Performance|Imported French Oils|Skin Friendly Formula|Luxury Gift Packaging' | split: '|' %}
      {% assign feature_texts = 'A long-lasting trail designed for office, evenings, parties, and special occasions.|Premium oil character with a refined projection and smooth dry-down.|Balanced formulation created for comfortable everyday wear.|Delivered with a premium unboxing experience that feels gift-ready.' | split: '|' %}
      {% for title in feature_titles %}
        <article class="bdp-feature-card" data-bd-card>
          <div class="bdp-feature-card__shine"></div>
          <div class="bdp-feature-card__icon">{{ forloop.index }}</div>
          <h3>{{ title }}</h3>
          <p>{{ feature_texts[forloop.index0] }}</p>
        </article>
      {% endfor %}
    </div>
  </section>

  <section
    id="bdp-product-buy-{{ sid }}"
    class="bdp-buy bdp-pad"
    data-bd-section>
    <div class="bdp-buy__media" data-bd-image-reveal>
      {% if bottle_image != blank %}
        <img
          src="{{ bottle_image | image_url: width: 1000 }}"
          width="800"
          height="1000"
          alt="{{ product.title | default: 'Big Daddy perfume product' | escape }}"
          loading="lazy">
      {% endif %}
      <div class="bdp-buy__halo"></div>
    </div>

    <div class="bdp-buy__panel" data-bd-anim>
      <p class="bdp-kicker">50ML · Eau de Parfum</p>
      <h2 class="bdp-h2">BIG DADDY</h2>
      <div class="bdp-rating">
        <span>★★★★★</span>
        <b>4.9</b>
        <em>Verified customer rating</em>
      </div>
      <p class="bdp-muted">A bold masculine fragrance with fresh citrus impact, aromatic heart notes, and a warm amber-wood base that leaves a premium, confident trail.</p>

      {% if product != blank %}
        <form class="bdp-product-form" data-product-form>
          <input
            type="hidden"
            name="product-id"
            value="{{ product.id }}">

          {% unless product.has_only_default_variant %}
            <label class="bdp-field-label" for="BdpVariant-{{ sid }}">Select Variant</label>
            <select
              id="BdpVariant-{{ sid }}"
              class="bdp-select"
              name="id"
              data-variant-select>
              {% for variant in product.variants %}
                <option
                  value="{{ variant.id }}"
                  data-price="{{ variant.price | money }}"
                  data-compare="{{ variant.compare_at_price | money }}"
                  data-available="{{ variant.available }}"
                  data-inventory="{{ variant.inventory_quantity }}"
                  {% if variant.image != blank %}
                  data-image="{{ variant.image | image_url: width: 800 }}"
                  {% endif %}
                  {% if variant == current_variant %}
                  selected{% endif %}>{{ variant.title }}</option>
              {% endfor %}
            </select>
          {% else %}
            <input
              type="hidden"
              name="id"
              value="{{ current_variant.id }}"
              data-variant-id>
          {% endunless %}

          <div class="bdp-price-row">
            <span class="bdp-price" data-product-price>{{ current_variant.price | money }}</span>
            {% if current_variant.compare_at_price > current_variant.price %}
              <s data-compare-price>{{ current_variant.compare_at_price | money }}</s>
            {% else %}
              <s data-compare-price hidden></s>
            {% endif %}
            <span class="bdp-offer-badge">Limited Launch Offer</span>
          </div>

          <div class="bdp-low-stock" data-low-stock>
            <i></i>
            <span>Only a few bottles left in this batch.</span>
          </div>

          <div class="bdp-progress-card">
            <div class="bdp-progress-card__top">
              <span>Shipping Milestone</span>
              <b>Free shipping unlocked</b>
            </div>
            <div class="bdp-progress">
              <span style="width:100%"></span>
            </div>
          </div>

          <div class="bdp-form-row">
            <div class="bdp-qty" aria-label="Quantity selector">
              <button type="button" data-qty-minus>-</button>
              <input
                type="number"
                name="quantity"
                value="1"
                min="1"
                max="10"
                data-qty-input
                aria-label="Quantity">
              <button type="button" data-qty-plus>+</button>
            </div>
            <button
              type="button"
              class="bdp-wishlist"
              data-wishlist
              aria-label="Add to wishlist">♡ Wishlist</button>
          </div>

          <button
            type="submit"
            class="bdp-btn bdp-btn--gold bdp-btn--full"
            data-add-to-cart
            data-magnetic>Add To Cart</button>
          <button
            type="button"
            class="bdp-btn bdp-btn--ghost bdp-btn--full"
            data-buy-now
            data-magnetic>Buy Now</button>

          <div class="bdp-cod-badge">COD Available · Secure Checkout · Easy Returns</div>
        </form>
      {% else %}
        <div class="bdp-empty-product">Select a product in this section settings to enable Shopify cart, variants, price, and buy buttons.</div>
      {% endif %}

      <div class="bdp-estimator">
        <label for="Pincode-{{ sid }}">Delivery Estimate</label>
        <div>
          <input
            id="Pincode-{{ sid }}"
            inputmode="numeric"
            maxlength="6"
            placeholder="Enter PIN code"
            data-pincode>
          <button type="button" data-check-pincode>Check</button>
        </div>
        <small data-pincode-result>Usually delivered in 2–5 business days.</small>
      </div>
    </div>
  </section>

  <section
    id="bdp-fragrance-{{ sid }}"
    class="bdp-showcase bdp-pad"
    data-bd-section>
    <div class="bdp-showcase__sticky">
      <div class="bdp-showcase__copy">
        <p class="bdp-kicker bdp-split">Cinematic Product Showcase</p>
        <h2 class="bdp-h2 bdp-split">Glass. Gold. Crimson. Command.</h2>
        <p class="bdp-muted bdp-reveal-line">A premium rectangular glass bottle with a leather-textured matte black cap, gold ring, and deep ruby perfume liquid designed to look as powerful as it smells.</p>
      </div>
      <div class="bdp-showcase__bottle" data-showcase-bottle>
        <div class="bdp-hotspot bdp-hotspot--top" tabindex="0">
          <button>1</button>
          <span>
            <b>Top Notes</b>
            Bergamot, pink pepper, lemon — fresh authority at first spray.</span>
        </div>
        <div class="bdp-hotspot bdp-hotspot--heart" tabindex="0">
          <button>2</button>
          <span>
            <b>Heart Notes</b>
            Lavender, jasmine, rose — smooth, clean, magnetic.</span>
        </div>
        <div class="bdp-hotspot bdp-hotspot--base" tabindex="0">
          <button>3</button>
          <span>
            <b>Base Notes</b>
            Amber, sandalwood, vanilla, musk — warm power that stays.</span>
        </div>
        {% if bottle_image != blank %}
          <img
            src="{{ bottle_image | image_url: width: 1000 }}"
            width="700"
            height="900"
            alt="Big Daddy bottle rotating showcase"
            loading="lazy">
        {% endif %}
        <div class="bdp-glass-reflection"></div>
      </div>
    </div>
  </section>

  <section class="bdp-notes bdp-pad" data-bd-section>
    <div class="bdp-section-head">
      <p class="bdp-kicker bdp-split">Fragrance Notes</p>
      <h2 class="bdp-h2 bdp-split">A confident scent architecture.</h2>
    </div>
    <div class="bdp-notes__grid">
      <article class="bdp-note-stage" data-note-stage>
        <span>01</span>
        <h3>Top Notes</h3>
        <div class="bdp-note-tags">
          <b>Bergamot</b>
          <b>Pink Pepper</b>
          <b>Lemon</b>
        </div>
      </article>
      <div class="bdp-note-arrow" aria-hidden="true">↓</div>
      <article class="bdp-note-stage" data-note-stage>
        <span>02</span>
        <h3>Heart Notes</h3>
        <div class="bdp-note-tags">
          <b>Lavender</b>
          <b>Jasmine</b>
          <b>Rose</b>
        </div>
      </article>
      <div class="bdp-note-arrow" aria-hidden="true">↓</div>
      <article class="bdp-note-stage" data-note-stage>
        <span>03</span>
        <h3>Base Notes</h3>
        <div class="bdp-note-tags">
          <b>Amber</b>
          <b>Sandalwood</b>
          <b>Vanilla</b>
          <b>Musk</b>
        </div>
      </article>
    </div>
  </section>

  <section class="bdp-story" data-bd-section>
    <div class="bdp-story__pin">
      <div class="bdp-story__text">
        <p class="bdp-kicker">Scroll Story</p>
        <h2 class="bdp-h2">From raw glass to a signature of power.</h2>
        <p class="bdp-muted">Follow the bottle as it forms, fills, seals, engraves, and reveals the crimson signature of Big Daddy.</p>
      </div>
      <div class="bdp-story__visual" aria-hidden="true">
        <div class="bdp-story__bottle">
          <div class="bdp-story__glass"></div>
          <div class="bdp-story__liquid"></div>
          <div class="bdp-story__cap"></div>
          <div class="bdp-story__ring"></div>
          <div class="bdp-story__label">
            <small>The Perfume Villa</small>
            <b>BIG<br>DADDY</b>
            <em>50ML</em>
          </div>
          <div class="bdp-story__shine"></div>
          <div class="bdp-story__smoke"></div>
        </div>
      </div>
      <div class="bdp-story__steps">
        <span data-story-step>Glass forms</span>
        <span data-story-step>Crimson fills</span>
        <span data-story-step>Cap lands</span>
        <span data-story-step>Gold engraves</span>
        <span data-story-step>Signature reveals</span>
      </div>
    </div>
  </section>

  <section class="bdp-love bdp-pad" data-bd-section>
    <div class="bdp-love__row">
      <div class="bdp-love__image" data-bd-image-reveal>
        {% if lifestyle_image != blank %}
          <img
            src="{{ lifestyle_image | image_url: width: 1100 }}"
            width="900"
            height="900"
            alt="Big Daddy luxury lifestyle"
            loading="lazy">
        {% endif %}
      </div>
      <div class="bdp-love__copy">
        <p class="bdp-kicker bdp-split">Why People Love It</p>
        <h2 class="bdp-h2 bdp-split">A masculine fragrance that feels expensive from the first spray.</h2>
        <ul class="bdp-lux-list">
          <li>Bold Masculine Fragrance</li>
          <li>Premium Imported Oils</li>
          <li>24 Hour Performance</li>
          <li>Elegant Packaging</li>
          <li>Perfect Gift</li>
          <li>Luxury Experience</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bdp-before-after bdp-pad" data-bd-section>
    <div class="bdp-section-head bdp-section-head--wide">
      <p class="bdp-kicker bdp-split">Before / After Experience</p>
      <h2 class="bdp-h2 bdp-split">From ordinary presence to unforgettable aura.</h2>
    </div>
    <div
      class="bdp-compare"
      data-compare
      style="--position:50%;">
      <div class="bdp-compare__image bdp-compare__before">
        {% if before_image != blank %}<img
            src="{{ before_image | image_url: width: 1400 }}"
            width="1200"
            height="800"
            alt="Before using Big Daddy"
            loading="lazy">{% else %}
          <div class="bdp-compare__placeholder">Before</div>
        {% endif %}
        <span>Before</span>
      </div>
      <div class="bdp-compare__image bdp-compare__after">
        {% if after_image != blank %}<img
            src="{{ after_image | image_url: width: 1400 }}"
            width="1200"
            height="800"
            alt="After using Big Daddy"
            loading="lazy">{% else %}
          <div class="bdp-compare__placeholder">After</div>
        {% endif %}
        <span>After</span>
      </div>
      <input
        type="range"
        min="0"
        max="100"
        value="50"
        aria-label="Before after comparison slider"
        data-compare-range>
      <div class="bdp-compare__handle"></div>
    </div>
  </section>

  <section class="bdp-testimonials bdp-pad" data-bd-section>
    <div class="bdp-section-head">
      <p class="bdp-kicker bdp-split">Verified Reviews</p>
      <h2 class="bdp-h2 bdp-split">Loved by men who like their fragrance bold.</h2>
    </div>
    <div class="bdp-tcarousel" data-testimonials>
      {% assign testimonial_count = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'testimonial' %}
          {% assign testimonial_count = testimonial_count | plus: 1 %}
          <article class="bdp-tcard" {{ block.shopify_attributes }}>
            {% if block.settings.photo != blank %}<img
                src="{{ block.settings.photo | image_url: width: 160 }}"
                width="74"
                height="74"
                alt="{{ block.settings.name | escape }}"
                loading="lazy">{% endif %}
            <div class="bdp-stars">★★★★★</div>
            <p>“{{ block.settings.review }}”</p>
            <h3>{{ block.settings.name }}</h3>
            <small>Verified Customer</small>
          </article>
        {% endif %}
      {% endfor %}
      {% if testimonial_count == 0 %}
        {% assign default_names = 'Arjun Mehta|Rohit Sharma|Kabir Malhotra|Aman Verma' | split: '|' %}
        {% assign default_reviews = 'The fragrance feels premium, powerful, and long lasting. It gets compliments without being loud.|The packaging and scent both feel luxury. Perfect for evening wear and special occasions.|Strong opening, smooth dry down, and excellent performance. My new signature scent.|Big Daddy smells expensive. Warm, masculine, and very confident.' | split: '|' %}
        {% for name in default_names %}
          <article class="bdp-tcard">
            <div class="bdp-avatar">{{ name | slice: 0 }}</div>
            <div class="bdp-stars">★★★★★</div>
            <p>“{{ default_reviews[forloop.index0] }}”</p>
            <h3>{{ name }}</h3>
            <small>Verified Customer</small>
          </article>
        {% endfor %}
      {% endif %}
    </div>
    {% if product != blank %}
      <div class="bdp-reviews-ready">
        <div
          class="jdgm-widget jdgm-review-widget"
          data-product-title="{{ product.title | escape }}"
          data-id="{{ product.id }}"></div>
        <div
          class="loox-rating"
          data-id="{{ product.id }}"
          data-rating="4.9"
          data-raters="100000"></div>
      </div>
    {% endif %}
  </section>

  <section class="bdp-video bdp-pad" data-bd-section>
    <div class="bdp-video__frame" data-video-frame>
      {% if section.settings.video_url != blank %}
        <video
          muted
          playsinline
          autoplay
          loop
          preload="metadata"
          data-scroll-video
          poster="{% if bottle_image != blank %}{{ bottle_image | image_url: width: 1200 }}{% endif %}">
          <source src="{{ section.settings.video_url | escape }}" type="video/mp4">
        </video>
      {% elsif hero_bg_image != blank %}
        <img
          src="{{ hero_bg_image | image_url: width: 1600 }}"
          width="1400"
          height="800"
          alt="Big Daddy cinematic perfume story"
          loading="lazy">
      {% endif %}
      <div class="bdp-video__overlay">
        <p class="bdp-kicker">Video Story</p>
        <h2>A cinematic bottle. A confident trail.</h2>
      </div>
    </div>
  </section>

  <section class="bdp-usp bdp-pad" data-bd-section>
    <div class="bdp-section-head">
      <p class="bdp-kicker bdp-split">Premium Experience</p>
      <h2 class="bdp-h2 bdp-split">Everything needed for confident checkout.</h2>
    </div>
    <div class="bdp-usp-grid">
      {% assign usps = 'Free Shipping|COD Available|Secure Checkout|Cruelty Free|Premium Ingredients|Long Lasting|Made in India|Luxury Packaging|Gift Ready|Easy Returns|24x7 Support|Premium Quality' | split: '|' %}
      {% for item in usps %}
        <article class="bdp-usp-card" data-bd-card>
          <span></span>
          <b>{{ item }}</b>
        </article>
      {% endfor %}
    </div>
  </section>

  <section class="bdp-stats bdp-pad" data-bd-section>
    <div class="bdp-stat" data-counter="100">
      <b>0K+</b>
      <span>Customers</span>
    </div>
    <div class="bdp-stat" data-counter="4.9">
      <b>0★</b>
      <span>Average Rating</span>
    </div>
    <div class="bdp-stat" data-counter="98">
      <b>0%</b>
      <span>Repeat Buyers</span>
    </div>
    <div class="bdp-stat" data-counter="50">
      <b>0+</b>
      <span>Cities Served</span>
    </div>
  </section>

  <section class="bdp-cross-sell bdp-pad" data-bd-section>
    <div class="bdp-section-head bdp-section-head--wide">
      <p class="bdp-kicker bdp-split">Complete The Ritual</p>
      <h2 class="bdp-h2 bdp-split">Frequently bought together.</h2>
    </div>
    <div class="bdp-bundle-grid">
      {% if section.settings.upsell_1 != blank or section.settings.upsell_2 != blank %}
        {% assign up = section.settings.upsell_1 %}
        {% if up != blank %}
          <article class="bdp-bundle-card" data-bd-card>
            {% if up.featured_image != blank %}<img
                src="{{ up.featured_image | image_url: width: 500 }}"
                width="420"
                height="420"
                alt="{{ up.title | escape }}"
                loading="lazy">{% endif %}
            <h3>{{ up.title }}</h3>
            <p>{{ up.price | money }}</p>
            <button class="bdp-btn bdp-btn--ghost bdp-btn--small" data-upsell-add="{{ up.selected_or_first_available_variant.id }}">Add</button>
          </article>
        {% endif %}
        {% assign up = section.settings.upsell_2 %}
