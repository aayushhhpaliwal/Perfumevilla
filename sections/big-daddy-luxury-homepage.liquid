    .bdp-sticky-atc {
      border-radius: 20px
    }.bdp-{{ sid }}
    .bdp-sticky-atc__product img {
      display: none
    }.bdp-{{ sid }}
    .bdp-sticky-atc .bdp-btn {
      min-width: 110px;
      padding: 0 14px
    }.bdp-{{ sid }}
    .bdp-email-popup {
      right: 12px;
      left: 12px;
      bottom: 12px;
      width: auto
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bdp-{{ sid }}* {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important
    }.bdp-{{ sid }}
    .bdp-cursor {
      display: none
    }
  }
</style>

<script>
  (() => {
  const root = document.getElementById('BigDaddyLuxury-{{ sid }}');
  if (!root || root.dataset.bdpReady === 'true') return;
  root.dataset.bdpReady = 'true';

  const moneyFallback = (v) => v || '';
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const loadScript = (src) => new Promise((resolve, reject) => {
    if ([...document.scripts].some(s => s.src === src)) return resolve();
    const s = document.createElement('script'); s.src = src; s.async = true; s.onload = resolve; s.onerror = reject; document.head.appendChild(s);
  });

  function splitText(){
    root.querySelectorAll('.bdp-split').forEach(el => {
      if (el.dataset.splitDone) return;
      const text = el.textContent.trim();
      el.textContent = '';
      text.split(' ').forEach((word, wi, arr) => {
        const w = document.createElement('span'); w.className = 'bdp-word';
        [...word].forEach(ch => { const c = document.createElement('span'); c.className = 'bdp-char'; c.textContent = ch; w.appendChild(c); });
        el.appendChild(w); if (wi < arr.length - 1) el.appendChild(document.createTextNode(' '));
      });
      el.dataset.splitDone = 'true';
    });
  }

  function initGsap(){
    if (!window.gsap || !window.ScrollTrigger) { initNonGsap(); return; }
    const gsap = window.gsap;
    gsap.registerPlugin(window.ScrollTrigger);
    if (window.Flip) gsap.registerPlugin(window.Flip);
    splitText();

    if (window.Lenis && !window.__bdpLenis && !prefersReduced) {
      window.__bdpLenis = new Lenis({ smoothWheel:true, lerp:.08, wheelMultiplier:.85 });
      window.__bdpLenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add((time) => window.__bdpLenis.raf(time * 1000));
      gsap.ticker.lagSmoothing(0);
    }

    const preloader = root.querySelector('.bdp-preloader');
    if (preloader) {
      const percent = preloader.querySelector('.bdp-preloader__percent');
      const obj = { value: 0 };
      const tl = gsap.timeline({ defaults:{ ease:'power3.out' }, onComplete(){ preloader.remove(); } });
      tl.to(preloader.querySelector('.bdp-preloader__logo'), { clipPath:'inset(0 0% 0 0)', duration:.9 })
        .to(preloader.querySelector('.bdp-preloader__bar span'), { width:'100%', duration:1.1, ease:'expo.inOut', onUpdate(){ obj.value = Math.round(this.progress() * 100); percent.textContent = obj.value + '%'; } }, '-=.2')
        .to(preloader, { opacity:0, filter:'blur(18px)', duration:.75 }, '+=.2');
    }

    const cursor = root.querySelector('.bdp-cursor');
    if (cursor && !prefersReduced) {
      window.addEventListener('pointermove', e => gsap.to(cursor, { x:e.clientX, y:e.clientY, duration:.7, ease:'power3.out' }), { passive:true });
    }

    root.querySelectorAll('.bdp-char').forEach(c => gsap.set(c, { yPercent:110, rotateX:-70, transformOrigin:'50% 100%', opacity:0 }));
    root.querySelectorAll('.bdp-split').forEach(el => {
      gsap.to(el.querySelectorAll('.bdp-char'), { yPercent:0, rotateX:0, opacity:1, duration:1.15, stagger:.018, ease:'expo.out', scrollTrigger:{ trigger:el, start:'top 86%' } });
    });

    root.querySelectorAll('.bdp-reveal-line').forEach(el => {
      gsap.fromTo(el, { y:34, clipPath:'inset(0 0 100% 0)', filter:'blur(12px)', opacity:0 }, { y:0, clipPath:'inset(0 0 0% 0)', filter:'blur(0px)', opacity:1, duration:1.05, ease:'power4.out', scrollTrigger:{ trigger:el, start:'top 88%' } });
    });

    root.querySelectorAll('[data-bd-anim]').forEach(el => {
      gsap.fromTo(el, { y:46, rotateX:-9, filter:'blur(14px)', opacity:0 }, { y:0, rotateX:0, filter:'blur(0px)', opacity:1, duration:1.1, ease:'power4.out', scrollTrigger:{ trigger:el, start:'top 88%' } });
    });

    root.querySelectorAll('[data-bd-card]').forEach((card, idx) => {
      gsap.fromTo(card, { y:90, rotateX:-16, scale:.96, filter:'blur(14px)', opacity:0 }, { y:0, rotateX:0, scale:1, filter:'blur(0px)', opacity:1, duration:1, delay:(idx%4)*.06, ease:'power4.out', scrollTrigger:{ trigger:card, start:'top 90%' } });
      card.addEventListener('pointermove', e => {
        const r = card.getBoundingClientRect();
        card.style.setProperty('--mx', ((e.clientX-r.left)/r.width*100)+'%');
        card.style.setProperty('--my', ((e.clientY-r.top)/r.height*100)+'%');
      });
    });

    root.querySelectorAll('[data-bd-image-reveal]').forEach(el => {
      gsap.to(el, { clipPath:'inset(0 0 0% 0)', duration:1.15, ease:'expo.out', scrollTrigger:{ trigger:el, start:'top 84%' } });
      const img = el.querySelector('img'); if (img) gsap.to(img, { scale:1, duration:1.6, ease:'expo.out', scrollTrigger:{ trigger:el, start:'top 84%' } });
    });

    const heroBottle = root.querySelector('[data-hero-bottle]');
    if (heroBottle && !prefersReduced) {
      gsap.to(heroBottle, { y:-36, rotateY:12, rotateX:-4, duration:4, yoyo:true, repeat:-1, ease:'sine.inOut' });
      root.querySelector('.bdp-hero')?.addEventListener('pointermove', e => {
        const x = (e.clientX / window.innerWidth - .5) * 22;
        const y = (e.clientY / window.innerHeight - .5) * -16;
        gsap.to(heroBottle, { rotateY:x, rotateX:y, x:x*1.7, y:y*1.2, duration:.8, ease:'power3.out' });
      }, { passive:true });
      gsap.to(heroBottle, { scale:.82, opacity:.55, scrollTrigger:{ trigger:root.querySelector('.bdp-hero'), start:'top top', end:'bottom top', scrub:1 } });
    }

    const showcaseBottle = root.querySelector('[data-showcase-bottle] img');
    if (showcaseBottle) {
      gsap.to(showcaseBottle, { rotateY:28, rotateX:5, scale:1.08, scrollTrigger:{ trigger:root.querySelector('.bdp-showcase'), start:'top top', end:'bottom bottom', scrub:1 } });
      gsap.to(root.querySelector('.bdp-glass-reflection'), { x:260, opacity:.8, scrollTrigger:{ trigger:root.querySelector('.bdp-showcase'), start:'top top', end:'bottom bottom', scrub:1 } });
    }

    const story = root.querySelector('.bdp-story');
    if (story && window.innerWidth > 989 && !prefersReduced) {
      const steps = story.querySelectorAll('[data-story-step]');
      const stl = gsap.timeline({ scrollTrigger:{ trigger:story, start:'top top', end:'bottom bottom', scrub:1 } });
      stl.to(story.querySelector('.bdp-story__glass'), { clipPath:'inset(0% 0 0 0)', duration:1 })
         .to(steps[0], { className:'+=is-active', duration:.05 }, '<')
         .to(story.querySelector('.bdp-story__liquid'), { height:'54%', duration:1.2, ease:'sine.inOut' })
         .to(steps[1], { className:'+=is-active', duration:.05 }, '<')
         .to(story.querySelector('.bdp-story__cap'), { y:0, duration:.8, ease:'bounce.out' })
         .to(story.querySelector('.bdp-story__ring'), { scaleX:1, duration:.55 }, '<+.2')
         .to(steps[2], { className:'+=is-active', duration:.05 }, '<')
         .to(story.querySelector('.bdp-story__label'), { opacity:1, scale:1, duration:.8, ease:'back.out(1.4)' })
         .to(steps[3], { className:'+=is-active', duration:.05 }, '<')
         .to(story.querySelector('.bdp-story__shine'), { x:'260%', duration:1.1, ease:'power2.inOut' })
         .to(story.querySelector('.bdp-story__smoke'), { opacity:.45, duration:.8 }, '<')
         .to(steps[4], { className:'+=is-active', duration:.05 }, '<');
    } else {
      root.querySelectorAll('.bdp-story__glass').forEach(el => el.style.clipPath = 'inset(0 0 0 0)');
      root.querySelectorAll('.bdp-story__liquid').forEach(el => el.style.height = '54%');
      root.querySelectorAll('.bdp-story__cap').forEach(el => el.style.transform = 'translate(-50%,0)');
      root.querySelectorAll('.bdp-story__ring').forEach(el => el.style.transform = 'translateX(-50%) scaleX(1)');
      root.querySelectorAll('.bdp-story__label').forEach(el => { el.style.opacity = '1'; el.style.transform = 'scale(1)'; });
    }

    root.querySelectorAll('[data-note-stage]').forEach((stage, i) => {
      gsap.fromTo(stage.querySelectorAll('span,h3,b'), { y:28, opacity:0, filter:'blur(10px)' }, { y:0, opacity:1, filter:'blur(0px)', stagger:.08, duration:.8, ease:'power4.out', scrollTrigger:{ trigger:stage, start:'top 80%' } });
    });

    root.querySelectorAll('.bdp-stat').forEach(stat => {
      const target = parseFloat(stat.dataset.counter || '0');
      const out = stat.querySelector('b');
      const suffix = out.textContent.includes('K') ? 'K+' : out.textContent.includes('%') ? '%' : out.textContent.includes('★') ? '★' : '+';
      gsap.fromTo(stat, { y:50, opacity:0, rotateX:-12 }, { y:0, opacity:1, rotateX:0, duration:.9, ease:'power4.out', scrollTrigger:{ trigger:stat, start:'top 86%' } });
      gsap.fromTo({ n:0 }, { n:0 }, { n:target, duration:1.4, ease:'power2.out', scrollTrigger:{ trigger:stat, start:'top 86%', once:true }, onUpdate(){ out.textContent = (target % 1 ? this.targets()[0].n.toFixed(1) : Math.round(this.targets()[0].n)) + suffix; } });
    });

    root.querySelectorAll('[data-magnetic]').forEach(btn => {
      btn.addEventListener('pointermove', e => {
        const r = btn.getBoundingClientRect();
        gsap.to(btn, { x:(e.clientX-r.left-r.width/2)*.18, y:(e.clientY-r.top-r.height/2)*.28, duration:.35, ease:'power3.out' });
      });
      btn.addEventListener('pointerleave', () => gsap.to(btn, { x:0, y:0, duration:.55, ease:'elastic.out(1,.35)' }));
    });

    const finalBottle = root.querySelector('[data-final-bottle] img');
    if (finalBottle) gsap.to(finalBottle, { y:-38, rotateY:10, duration:4.6, repeat:-1, yoyo:true, ease:'sine.inOut' });

    ScrollTrigger.create({ trigger:root.querySelector('.bdp-buy'), start:'bottom bottom', endTrigger:root, end:'bottom bottom', onEnter:()=>root.querySelector('[data-sticky-atc]')?.classList.add('is-visible'), onLeaveBack:()=>root.querySelector('[data-sticky-atc]')?.classList.remove('is-visible') });
  }

  function initNonGsap(){
    root.querySelectorAll('[data-bd-image-reveal]').forEach(el => el.style.clipPath = 'inset(0 0 0 0)');
    root.querySelectorAll('.bdp-preloader').forEach(el => el.remove());
  }

  function initUi(){
    const compare = root.querySelector('[data-compare]');
    if (compare) compare.querySelector('[data-compare-range]')?.addEventListener('input', e => compare.style.setProperty('--position', e.target.value + '%'));

    const form = root.querySelector('[data-product-form]');
    const variantSelect = root.querySelector('[data-variant-select]');
    const price = root.querySelector('[data-product-price]');
    const stickyPrice = root.querySelector('[data-sticky-price]');
    const comparePrice = root.querySelector('[data-compare-price]');
    const qtyInput = root.querySelector('[data-qty-input]');
    const lowStock = root.querySelector('[data-low-stock] span');
    const getVariantId = () => variantSelect ? variantSelect.value : root.querySelector('[data-variant-id]')?.value;
    const getQty = () => Math.max(1, parseInt(qtyInput?.value || '1', 10));

    variantSelect?.addEventListener('change', () => {
      const opt = variantSelect.selectedOptions[0];
      if (price) price.textContent = moneyFallback(opt.dataset.price);
      if (stickyPrice) stickyPrice.textContent = moneyFallback(opt.dataset.price);
      if (comparePrice) {
        if (opt.dataset.compare && opt.dataset.compare !== '') { comparePrice.hidden = false; comparePrice.textContent = opt.dataset.compare; } else { comparePrice.hidden = true; }
      }
      if (lowStock) {
        const inv = parseInt(opt.dataset.inventory || '0', 10);
        lowStock.textContent = inv > 0 && inv <= 8 ? `Only ${inv} bottles left in this batch.` : 'Only a few bottles left in this batch.';
      }
      if (opt.dataset.available === 'false') root.querySelector('[data-add-to-cart]').textContent = 'Sold Out'; else root.querySelector('[data-add-to-cart]').textContent = 'Add To Cart';
    });

    root.querySelector('[data-qty-minus]')?.addEventListener('click', () => { qtyInput.value = Math.max(1, getQty() - 1); });
    root.querySelector('[data-qty-plus]')?.addEventListener('click', () => { qtyInput.value = Math.min(10, getQty() + 1); });

    async function addToCart(variantId, quantity, redirect){
      if (!variantId) return;
      const buttons = root.querySelectorAll('[data-add-to-cart], [data-sticky-add], [data-buy-now]');
      buttons.forEach(b => { b.disabled = true; b.dataset.oldText = b.textContent; b.textContent = 'Adding...'; });
      try {
        await fetch('{{ routes.cart_add_url }}.js', { method:'POST', headers:{ 'Content-Type':'application/json', 'Accept':'application/json' }, body:JSON.stringify({ id:Number(variantId), quantity:Number(quantity || 1) }) });
        document.dispatchEvent(new CustomEvent('cart:refresh'));
        document.dispatchEvent(new CustomEvent('cart-drawer:open'));
        if (window.theme?.cartDrawer?.open) window.theme.cartDrawer.open();
        const drawer = document.querySelector('cart-drawer');
        if (drawer && typeof drawer.open === 'function') drawer.open();
        if (redirect) window.location.href = '/checkout';
        buttons.forEach(b => { b.textContent = redirect ? 'Redirecting...' : 'Added'; });
        setTimeout(() => buttons.forEach(b => { b.disabled = false; b.textContent = b.dataset.oldText || 'Add To Cart'; }), 1100);
      } catch(e) {
        console.error(e); buttons.forEach(b => { b.disabled = false; b.textContent = 'Try Again'; });
        setTimeout(() => buttons.forEach(b => { b.textContent = b.dataset.oldText || 'Add To Cart'; }), 1400);
      }
    }

    form?.addEventListener('submit', e => { e.preventDefault(); addToCart(getVariantId(), getQty(), false); });
    root.querySelector('[data-buy-now]')?.addEventListener('click', () => addToCart(getVariantId(), getQty(), true));
    root.querySelector('[data-sticky-add]')?.addEventListener('click', () => addToCart(getVariantId(), getQty(), true));
    root.querySelectorAll('[data-upsell-add]').forEach(btn => btn.addEventListener('click', () => addToCart(btn.dataset.upsellAdd, 1, false)));

    const wish = root.querySelector('[data-wishlist]');
    if (wish) {
      const key = 'bdp_wishlist_{{ product.id | default: 'big-daddy' }}';
      if (localStorage.getItem(key)) wish.classList.add('is-active');
      wish.addEventListener('click', () => { wish.classList.toggle('is-active'); wish.classList.contains('is-active') ? localStorage.setItem(key,'1') : localStorage.removeItem(key); wish.textContent = wish.classList.contains('is-active') ? '♥ Wishlisted' : '♡ Wishlist'; });
    }

    root.querySelector('[data-check-pincode]')?.addEventListener('click', () => {
      const pin = root.querySelector('[data-pincode]')?.value.trim() || '';
      const out = root.querySelector('[data-pincode-result]');
      if (!/^\d{6}$/.test(pin)) { out.textContent = 'Please enter a valid 6-digit PIN code.'; out.style.color = '#E4C88A'; return; }
      const days = ['2–3', '3–5', '4–6'][parseInt(pin.slice(-1),10) % 3];
      out.textContent = `Estimated delivery: ${days} business days. COD availability may vary by location.`;
      out.style.color = '#BEB9AE';
    });

    root.querySelectorAll('.bdp-acc-item button').forEach(btn => btn.addEventListener('click', () => {
      const item = btn.closest('.bdp-acc-item'); const panel = item.querySelector('div'); const open = item.classList.contains('is-open');
      root.querySelectorAll('.bdp-acc-item.is-open').forEach(i => { if (i !== item) { i.classList.remove('is-open'); if (window.gsap) gsap.to(i.querySelector('div'), { height:0, duration:.38, ease:'power3.inOut' }); else i.querySelector('div').style.height = '0'; } });
      item.classList.toggle('is-open', !open);
      if (window.gsap) gsap.to(panel, { height:open ? 0 : 'auto', duration:.45, ease:'power3.inOut' }); else panel.style.height = open ? '0' : 'auto';
    }));

    const carousel = root.querySelector('[data-testimonials]');
    if (carousel) setInterval(() => { if (document.hidden || carousel.matches(':hover')) return; const next = carousel.scrollLeft + carousel.clientWidth * .75; carousel.scrollTo({ left: next >= carousel.scrollWidth - carousel.clientWidth ? 0 : next, behavior:'smooth' }); }, 3600);

    function tickCountdown(){
      const now = new Date(); const end = new Date(); end.setHours(23,59,59,999);
      const diff = Math.max(0, end - now); const h = String(Math.floor(diff/36e5)).padStart(2,'0'); const m = String(Math.floor(diff%36e5/6e4)).padStart(2,'0'); const s = String(Math.floor(diff%6e4/1000)).padStart(2,'0');
      root.querySelectorAll('[data-countdown]').forEach(el => el.textContent = `${h}:${m}:${s}`);
    }
    tickCountdown(); setInterval(tickCountdown, 1000);

    const recent = root.querySelector('[data-recent-popup]');
    setTimeout(() => { if (recent && !sessionStorage.getItem('bdp_recent_closed')) recent.hidden = false; }, 6500);
    root.querySelector('[data-close-recent]')?.addEventListener('click', () => { recent.hidden = true; sessionStorage.setItem('bdp_recent_closed','1'); });

    const email = root.querySelector('[data-email-popup]');
    setTimeout(() => { if (email && !localStorage.getItem('bdp_email_closed')) email.hidden = false; }, 11000);
    root.querySelector('[data-close-email]')?.addEventListener('click', () => { email.hidden = true; localStorage.setItem('bdp_email_closed','1'); });
  }

  initUi();
  if (prefersReduced) { initNonGsap(); return; }
  Promise.all([
    loadScript('https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js'),
    loadScript('https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js'),
    loadScript('https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/Flip.min.js'),
    loadScript('https://unpkg.com/lenis@1.1.14/dist/lenis.min.js')
  ]).then(initGsap).catch(initNonGsap);
  })();
</script>

