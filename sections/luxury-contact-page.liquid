{%- liquid
  assign section_id = 'LuxuryContact-' | append: section.id
  assign form_id = 'LuxuryContactForm-' | append: section.id
-%}

{%- style -%}
  #{{ section_id }} {
    --contact-ink: #1d1a17;
    --contact-muted: #665f57;
    --contact-gold: #9b7436;
    --contact-line: rgba(49, 42, 34, 0.22);
    position: relative;
    isolation: isolate;
    min-height: min(860px, calc(100svh - 72px));
    display: flex;
    align-items: center;
    overflow: hidden;
    color: var(--contact-ink);
    background-color: #eee3d3;
    background-image: url(
      {%- if section.settings.background_image != blank -%}
        {{ section.settings.background_image | image_url: width: 2400 }}
      {%- else -%}
        {{ 'contact-page-background.jpg' | asset_url }}
      {%- endif -%}
    );
    background-position: center center;
    background-repeat: no-repeat;
    background-size: cover;
  }

  #{{ section_id }}::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(90deg, rgba(250, 247, 241, 0.97) 0%, rgba(250, 247, 241, 0.91) 35%, rgba(250, 247, 241, 0.42) 57%, rgba(250, 247, 241, 0) 74%);
    pointer-events: none;
  }

  #{{ section_id }} .pv-contact__inner {
    width: min(100%, 1500px);
    margin-inline: auto;
    padding: clamp(56px, 6vw, 96px) clamp(24px, 5vw, 80px);
  }

  #{{ section_id }} .pv-contact__layout {
    width: min(100%, 940px);
    display: grid;
    grid-template-columns: minmax(190px, 230px) minmax(0, 620px);
    align-items: end;
    gap: clamp(36px, 4.5vw, 72px);
  }

  #{{ section_id }} .pv-contact__content {
    grid-column: 2;
    min-width: 0;
  }

  #{{ section_id }} .pv-contact__eyebrow {
    margin: 0 0 12px;
    color: var(--contact-gold);
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  #{{ section_id }} .pv-contact__title {
    margin: 0;
    color: var(--contact-ink);
    font-family: var(--font-heading-family);
    font-size: clamp(4rem, 4vw, 6.2rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  #{{ section_id }} .pv-contact__title::after {
    content: '';
    display: block;
    width: 52px;
    height: 1px;
    margin-top: 18px;
    background: rgba(155, 116, 54, 0.38);
  }

  #{{ section_id }} .pv-contact__intro {
    max-width: 600px;
    margin: 20px 0 28px;
    color: var(--contact-muted);
    font-size: clamp(1.6rem, 1.2vw, 1.8rem);
    letter-spacing: 0.015em;
    line-height: 1.65;
  }

  #{{ section_id }} .pv-contact__details {
    grid-column: 1;
    display: grid;
    gap: 22px;
    padding: 28px 24px;
    border: 1px solid rgba(155, 116, 54, 0.08);
    border-radius: 90px 90px 20px 20px;
    background: rgba(248, 243, 234, 0.6);
    backdrop-filter: blur(8px);
  }

  #{{ section_id }} .pv-contact__detail {
    display: grid;
    grid-template-columns: 46px minmax(0, 1fr);
    align-items: center;
    gap: 14px;
    color: var(--contact-ink);
    text-decoration: none;
  }

  #{{ section_id }} .pv-contact__detail-icon {
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(155, 116, 54, 0.42);
    border-radius: 50%;
    color: var(--contact-gold);
    transition: color 180ms ease, background-color 180ms ease, transform 180ms ease;
  }

  #{{ section_id }} a.pv-contact__detail:hover .pv-contact__detail-icon {
    color: #fff;
    background: var(--contact-gold);
    transform: translateY(-2px);
  }

  #{{ section_id }} .pv-contact__detail-icon svg {
    width: 23px;
    height: 23px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }

  #{{ section_id }} .pv-contact__detail strong,
  #{{ section_id }} .pv-contact__detail span {
    display: block;
  }

  #{{ section_id }} .pv-contact__detail strong {
    margin-bottom: 3px;
    font-size: 1.4rem;
    font-weight: 600;
    line-height: 1.25;
  }

  #{{ section_id }} .pv-contact__detail span {
    color: var(--contact-muted);
    font-size: 1.3rem;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  #{{ section_id }} .pv-contact__form {
    width: 100%;
  }

  #{{ section_id }} .pv-contact__form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  #{{ section_id }} .pv-contact__field--full {
    grid-column: 1 / -1;
  }

  #{{ section_id }} .pv-contact__field label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  #{{ section_id }} .pv-contact__input {
    width: 100%;
    height: 56px;
    padding: 0 20px;
    border: 1px solid var(--contact-line);
    border-radius: 0;
    outline: 0;
    color: var(--contact-ink);
    background: rgba(255, 255, 255, 0.5);
    box-shadow: none;
    font: inherit;
    font-size: 1.6rem;
    transition: border-color 180ms ease, background-color 180ms ease, box-shadow 180ms ease;
  }

  #{{ section_id }} textarea.pv-contact__input {
    min-height: 132px;
    padding-block: 17px;
    resize: vertical;
  }

  #{{ section_id }} .pv-contact__input::placeholder {
    color: #777068;
    opacity: 1;
  }

  #{{ section_id }} .pv-contact__input:focus {
    border-color: var(--contact-gold);
    background: rgba(255, 255, 255, 0.82);
    box-shadow: 0 0 0 3px rgba(155, 116, 54, 0.1);
  }

  #{{ section_id }} .pv-contact__submit {
    min-width: 126px;
    min-height: 50px;
    margin-top: 20px;
    padding: 12px 30px;
    border: 1px solid #121212;
    border-radius: 999px;
    color: #fff;
    background: #121212;
    font: inherit;
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: color 180ms ease, background-color 180ms ease, transform 180ms ease;
  }

  #{{ section_id }} .pv-contact__submit:hover {
    color: #121212;
    background: transparent;
    transform: translateY(-2px);
  }

  #{{ section_id }} .pv-contact__status {
    margin: 0 0 18px;
    padding: 13px 15px;
    border: 1px solid rgba(44, 110, 65, 0.3);
    color: #285f39;
    background: rgba(235, 247, 238, 0.82);
    font-size: 1.5rem;
    line-height: 1.45;
  }

  #{{ section_id }} .pv-contact__status--error {
    border-color: rgba(153, 45, 45, 0.28);
    color: #872e2e;
    background: rgba(252, 236, 236, 0.84);
  }

  #{{ section_id }} .pv-contact__errors {
    margin: 8px 0 0;
    padding-left: 20px;
  }

  @media screen and (max-width: 1100px) {
    #{{ section_id }} {
      background-position: 62% center;
    }

    #{{ section_id }}::before {
      background: linear-gradient(90deg, rgba(250, 247, 241, 0.97) 0%, rgba(250, 247, 241, 0.92) 48%, rgba(250, 247, 241, 0.32) 80%, rgba(250, 247, 241, 0.06) 100%);
    }

    #{{ section_id }} .pv-contact__layout {
      width: min(100%, 760px);
      grid-template-columns: 1fr;
      align-items: start;
      gap: 34px;
    }

    #{{ section_id }} .pv-contact__content,
    #{{ section_id }} .pv-contact__details {
      grid-column: 1;
    }

    #{{ section_id }} .pv-contact__details {
      grid-row: 2;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
      padding: 20px;
      border-radius: 24px;
    }

    #{{ section_id }} .pv-contact__detail {
      grid-template-columns: 38px minmax(0, 1fr);
      gap: 10px;
    }

    #{{ section_id }} .pv-contact__detail-icon {
      width: 38px;
      height: 38px;
    }

    #{{ section_id }} .pv-contact__detail-icon svg {
      width: 20px;
      height: 20px;
    }
  }

  @media screen and (max-width: 749px) {
    #{{ section_id }} {
      min-height: auto;
      align-items: stretch;
      background-position: 68% center;
    }

    #{{ section_id }}::before {
      background: rgba(250, 247, 241, 0.88);
      backdrop-filter: blur(2px);
    }

    #{{ section_id }} .pv-contact__inner {
      padding: 48px 18px 56px;
    }

    #{{ section_id }} .pv-contact__layout {
      gap: 28px;
    }

    #{{ section_id }} .pv-contact__content {
      padding: 24px 18px;
      border: 1px solid rgba(155, 116, 54, 0.12);
      border-radius: 24px;
      background: rgba(255, 252, 247, 0.72);
      box-shadow: 0 20px 60px rgba(84, 61, 35, 0.08);
      backdrop-filter: blur(12px);
    }

    #{{ section_id }} .pv-contact__eyebrow {
      font-size: 1.2rem;
    }

    #{{ section_id }} .pv-contact__title {
      font-size: clamp(3.6rem, 12vw, 4.8rem);
    }

    #{{ section_id }} .pv-contact__intro {
      margin-bottom: 24px;
      font-size: 1.6rem;
    }

    #{{ section_id }} .pv-contact__form-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    #{{ section_id }} .pv-contact__field--full {
      grid-column: 1;
    }

    #{{ section_id }} .pv-contact__input {
      height: 54px;
      padding-inline: 16px;
      background: rgba(255, 255, 255, 0.8);
    }

    #{{ section_id }} textarea.pv-contact__input {
      min-height: 128px;
    }

    #{{ section_id }} .pv-contact__submit {
      width: 100%;
      min-height: 54px;
    }

    #{{ section_id }} .pv-contact__details {
      grid-template-columns: 1fr;
      gap: 18px;
      padding: 22px;
      background: rgba(255, 252, 247, 0.76);
      backdrop-filter: blur(12px);
    }

    #{{ section_id }} .pv-contact__detail {
      grid-template-columns: 44px minmax(0, 1fr);
    }

    #{{ section_id }} .pv-contact__detail-icon {
      width: 44px;
      height: 44px;
    }

    #{{ section_id }} .pv-contact__detail strong {
      font-size: 1.5rem;
    }

    #{{ section_id }} .pv-contact__detail span {
      font-size: 1.4rem;
    }
  }
{%- endstyle -%}

<section id="{{ section_id }}" class="pv-contact" aria-labelledby="{{ section_id }}-title">
  <div class="pv-contact__inner">
    <div class="pv-contact__layout">
      <div class="pv-contact__details" aria-label="Contact information">
        {%- if section.settings.email != blank -%}
          <a class="pv-contact__detail" href="mailto:{{ section.settings.email | escape }}">
            <span class="pv-contact__detail-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><rect x="2.5" y="4.5" width="19" height="15" rx="1.5"></rect><path d="m3.5 6 8.5 7 8.5-7"></path></svg>
            </span>
            <span>
              <strong>{{ section.settings.email_label | escape }}</strong>
              <span>{{ section.settings.email | escape }}</span>
            </span>
          </a>
        {%- endif -%}

        {%- if section.settings.phone != blank -%}
          <a class="pv-contact__detail" href="tel:{{ section.settings.phone | remove: ' ' | remove: '-' | escape }}">
            <span class="pv-contact__detail-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M8.1 3.1 5.6 2.5c-.8-.2-1.7.2-2.1 1C1.2 7.3 3 13 6.8 16.8s9.5 5.6 13.3 3.3c.8-.5 1.2-1.3 1-2.1l-.6-2.5c-.2-.8-.9-1.4-1.7-1.4l-3.1-.1c-.7 0-1.3.4-1.6 1l-.6 1.4a12.8 12.8 0 0 1-5.9-5.9L9 9.9c.6-.3 1-.9 1-1.6l-.1-3.1c0-1-.8-1.8-1.8-2.1Z"></path></svg>
            </span>
            <span>
              <strong>{{ section.settings.phone_label | escape }}</strong>
              <span>{{ section.settings.phone | escape }}</span>
            </span>
          </a>
        {%- endif -%}

        {%- if section.settings.hours != blank -%}
          <div class="pv-contact__detail">
            <span class="pv-contact__detail-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 6.5V12l3.7 2.2"></path></svg>
            </span>
            <span>
              <strong>{{ section.settings.hours_label | escape }}</strong>
              <span>{{ section.settings.hours | escape }}</span>
            </span>
          </div>
        {%- endif -%}
      </div>

      <div class="pv-contact__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="pv-contact__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h1 id="{{ section_id }}-title" class="pv-contact__title">{{ section.settings.heading | escape }}</h1>
        {%- if section.settings.intro != blank -%}
          <div class="pv-contact__intro">{{ section.settings.intro }}</div>
        {%- endif -%}

        {%- form 'contact', id: form_id, class: 'pv-contact__form' -%}
          {%- if form.posted_successfully? -%}
            <div class="pv-contact__status" role="status" tabindex="-1" autofocus>
              {{ 'templates.contact.form.post_success' | t }}
            </div>
          {%- endif -%}

          {%- if form.errors -%}
            <div class="pv-contact__status pv-contact__status--error" role="alert" tabindex="-1" autofocus>
              {{ 'templates.contact.form.error_heading' | t }}
              <ul class="pv-contact__errors">
                {%- for field in form.errors -%}
                  <li>
                    {%- if field == 'form' -%}
                      {{ form.errors.messages[field] }}
                    {%- else -%}
                      {{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          <div class="pv-contact__form-grid">
            <div class="pv-contact__field">
              <label for="{{ form_id }}-name">{{ 'templates.contact.form.name' | t }}</label>
              <input
                class="pv-contact__input"
                id="{{ form_id }}-name"
                type="text"
                name="contact[name]"
                autocomplete="name"
                value="{% if form.name %}{{ form.name | escape }}{% elsif customer %}{{ customer.name | escape }}{% endif %}"
                placeholder="{{ 'templates.contact.form.name' | t }}"
              >
            </div>

            <div class="pv-contact__field">
              <label for="{{ form_id }}-email">{{ 'templates.contact.form.email' | t }}</label>
              <input
                class="pv-contact__input"
                id="{{ form_id }}-email"
                type="email"
                name="contact[email]"
                autocomplete="email"
                autocapitalize="off"
                spellcheck="false"
                required
                aria-required="true"
                value="{% if form.email %}{{ form.email | escape }}{% elsif customer %}{{ customer.email | escape }}{% endif %}"
                placeholder="{{ 'templates.contact.form.email' | t }} *"
              >
            </div>

            <div class="pv-contact__field pv-contact__field--full">
              <label for="{{ form_id }}-phone">{{ 'templates.contact.form.phone' | t }}</label>
              <input
                class="pv-contact__input"
                id="{{ form_id }}-phone"
                type="tel"
                name="contact[phone]"
                autocomplete="tel"
                value="{% if form.phone %}{{ form.phone | escape }}{% elsif customer %}{{ customer.phone | escape }}{% endif %}"
                placeholder="{{ 'templates.contact.form.phone' | t }}"
              >
            </div>

            <div class="pv-contact__field pv-contact__field--full">
              <label for="{{ form_id }}-body">{{ 'templates.contact.form.comment' | t }}</label>
              <textarea
                class="pv-contact__input"
                id="{{ form_id }}-body"
                name="contact[body]"
                rows="5"
                required
                aria-required="true"
                placeholder="{{ 'templates.contact.form.comment' | t }}"
              >{{- form.body -}}</textarea>
            </div>
          </div>

          <button class="pv-contact__submit" type="submit">{{ section.settings.button_label | escape }}</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Luxury contact page",
  "tag": "section",
  "class": "section section-luxury-contact",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Uses the included Big Daddy image when left blank."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "GET IN TOUCH"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Contact"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction",
      "default": "<p>We'd love to hear from you! Whether you have a question about our fragrances, need help with an order, or just want to say hello — we're here for you.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Send"
    },
    {
      "type": "header",
      "content": "Contact details"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "Email Us"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email address",
      "default": "info@theperfumevilla.com"
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Phone label",
      "default": "Call Us"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number",
      "default": "+91 98765 43210"
    },
    {
      "type": "text",
      "id": "hours_label",
      "label": "Hours label",
      "default": "Working Hours"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Working hours",
      "default": "Mon - Sat: 10AM - 7PM"
    }
  ],
  "presets": [
    {
      "name": "Luxury contact page"
    }
  ]
}
{% endschema %}
