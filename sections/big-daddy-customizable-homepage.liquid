{% comment %}
  Customizable Shopify OS 2.0 conversion of the supplied standalone BIG DADDY HTML.
{% endcomment %}

{% liquid
  assign sid = section.id
  assign product = section.settings.product
  assign current_variant = product.selected_or_first_available_variant
  assign hero_image = section.settings.hero_image
  assign studio_image = section.settings.studio_image
  assign notes_image = section.settings.notes_image
  assign compare_before_image = section.settings.compare_before_image
  assign compare_after_image = section.settings.compare_after_image

  if hero_image == blank and product.featured_image != blank
    assign hero_image = product.featured_image
  endif
  if studio_image == blank
    assign studio_image = hero_image
  endif
  if notes_image == blank
    assign notes_image = hero_image
  endif
  if compare_before_image == blank
    assign compare_before_image = studio_image
  endif
  if compare_after_image == blank
    assign compare_after_image = hero_image
  endif
  assign primary_href = section.settings.primary_link
  assign secondary_href = section.settings.secondary_link
  if primary_href == blank
    assign primary_href = '#bdc-buy-' | append: sid
  endif
  if secondary_href == blank
    assign secondary_href = '#bdc-notes-' | append: sid
  endif
%}

<section
  id="BigDaddyCustom-{{ sid }}"
  class="bdc bdc-{{ sid }}"
  data-bdc-root
  data-section-id="{{ sid }}"
  {% if product != blank %}data-product-id="{{ product.id }}"{% endif %}>
  {% if section.settings.enable_preloader %}
    <div class="bdc-preloader" data-bdc-preloader aria-hidden="true">
      <div class="bdc-loader-orb"></div>
      <div class="bdc-loader-box">
        <div class="bdc-loader-brand">{{ section.settings.brand_name }}</div>
        <div class="bdc-loader-sub">{{ section.settings.product_name }}</div>
        <div class="bdc-loader-track"><span data-bdc-loader-bar></span></div>
        <div class="bdc-loader-percent" data-bdc-loader-percent>0%</div>
      </div>
    </div>
  {% endif %}

  <header class="bdc-site-header" data-bdc-header>
    <div class="bdc-container bdc-nav">
      <a class="bdc-brand" href="{{ routes.root_url }}" aria-label="{{ section.settings.brand_name | escape }}">
        {% if section.settings.logo != blank %}
          <img src="{{ section.settings.logo | image_url: width: 120 }}" width="42" height="42" alt="{{ section.settings.brand_name | escape }}">
        {% else %}
          <span class="bdc-brand-mark">{{ section.settings.brand_mark }}</span>
        {% endif %}
        <span class="bdc-brand-text">
          <strong>{{ section.settings.brand_name }}</strong>
          <small>{{ section.settings.brand_subtitle }}</small>
        </span>
      </a>
      <nav class="bdc-nav-links" aria-label="Section navigation">
        <a href="#bdc-fragrance-{{ sid }}">{{ section.settings.nav_1 }}</a>
        <a href="#bdc-notes-{{ sid }}">{{ section.settings.nav_2 }}</a>
        <a href="#bdc-reviews-{{ sid }}">{{ section.settings.nav_3 }}</a>
        <a href="#bdc-faq-{{ sid }}">{{ section.settings.nav_4 }}</a>
      </nav>
      <a class="bdc-icon-btn" href="{{ routes.cart_url }}" aria-label="Cart">
        <span>{{ cart.item_count }}</span>
      </a>
    </div>
  </header>

  <main>
    <section class="bdc-hero" id="bdc-hero-{{ sid }}" aria-labelledby="bdcHeroTitle-{{ sid }}">
      {% if section.settings.enable_particles %}
        <canvas class="bdc-particles" data-bdc-particles aria-hidden="true"></canvas>
      {% endif %}
      <div class="bdc-smoke" aria-hidden="true"><span></span><span></span><span></span></div>
      <div class="bdc-hero-shell">
        <div class="bdc-hero-copy">
          <p class="bdc-eyebrow" data-bdc-reveal>{{ section.settings.hero_eyebrow }}</p>
          <h1 class="bdc-hero-title" id="bdcHeroTitle-{{ sid }}" data-bdc-reveal>
            {{ section.settings.hero_heading }}
            <span>{{ section.settings.hero_heading_outline }}</span>
          </h1>
          <p data-bdc-reveal>{{ section.settings.hero_text }}</p>
          <div class="bdc-buttons" data-bdc-reveal>
            <a class="bdc-btn bdc-btn-primary" href="{{ primary_href }}">{{ section.settings.primary_label }}</a>
            <a class="bdc-btn bdc-btn-ghost" href="{{ secondary_href }}">{{ section.settings.secondary_label }}</a>
          </div>
        </div>
        <div class="bdc-hero-product-wrap" data-bdc-tilt-wrap>
          <div class="bdc-hero-spotlight"></div>
          <div class="bdc-hero-bottle" data-bdc-tilt>
            {% if hero_image != blank %}
              <img
                src="{{ hero_image | image_url: width: 1000 }}"
                srcset="{{ hero_image | image_url: width: 480 }} 480w, {{ hero_image | image_url: width: 760 }} 760w, {{ hero_image | image_url: width: 1000 }} 1000w"
                sizes="(max-width: 749px) 84vw, 440px"
                width="900"
                height="900"
                alt="{{ section.settings.hero_image_alt | escape }}">
            {% else %}
              <div class="bdc-image-fallback">
                <small>{{ section.settings.brand_name }}</small>
                <b>{{ section.settings.product_name }}</b>
              </div>
            {% endif %}
            <span class="bdc-hero-reflection"></span>
          </div>
        </div>
        <aside class="bdc-mini-card" data-bdc-reveal>
          <strong>{{ section.settings.hero_stat_number }}</strong>
          <p>{{ section.settings.hero_stat_text }}</p>
        </aside>
      </div>
      <div class="bdc-trust-bar">
        {% assign trust_items = section.settings.trust_items | split: '|' %}
        {% for item in trust_items limit: 4 %}
          <span>{{ item }}</span>
        {% endfor %}
      </div>
    </section>

    <section class="bdc-marquee-section" aria-label="Trust strip">
      <div class="bdc-marquee">
        {% assign marquee_items = section.settings.marquee_items | split: '|' %}
        {% for copy in (1..2) %}
          <div class="bdc-marquee-track">
            {% for item in marquee_items %}
              <span class="bdc-marquee-item"><i>*</i>{{ item }}</span>
            {% endfor %}
          </div>
        {% endfor %}
      </div>
    </section>

    <section class="bdc-padded" id="bdc-fragrance-{{ sid }}">
      <div class="bdc-container">
        <div class="bdc-intro-row">
          <div>
            <p class="bdc-eyebrow" data-bdc-reveal>{{ section.settings.features_eyebrow }}</p>
            <h2 class="bdc-section-title" data-bdc-reveal>{{ section.settings.features_heading }}</h2>
          </div>
          <p class="bdc-section-copy" data-bdc-reveal>{{ section.settings.features_text }}</p>
        </div>
        <div class="bdc-grid bdc-feature-grid">
          {% for block in section.blocks %}
            {% if block.type == 'feature' %}
              <article class="bdc-glass bdc-feature-card" data-bdc-reveal {{ block.shopify_attributes }}>
                <span class="bdc-feature-icon">{{ block.settings.icon }}</span>
                <div>
                  <h3>{{ block.settings.title }}</h3>
                  <p>{{ block.settings.text }}</p>
                </div>
              </article>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </section>

    <section class="bdc-showcase" id="bdc-showcase-{{ sid }}">
      <div class="bdc-container bdc-showcase-grid">
        <div class="bdc-showcase-side">
          <article class="bdc-glass bdc-spec-card" data-bdc-reveal>
            <span>{{ section.settings.showcase_left_label }}</span>
            <h3>{{ section.settings.showcase_left_heading }}</h3>
            <p>{{ section.settings.showcase_left_text }}</p>
          </article>
          <article class="bdc-glass bdc-spec-card" data-bdc-reveal>
            <span>{{ section.settings.showcase_left_label_2 }}</span>
            <h3>{{ section.settings.showcase_left_heading_2 }}</h3>
            <p>{{ section.settings.showcase_left_text_2 }}</p>
          </article>
        </div>
        <div class="bdc-showcase-product">
          <div class="bdc-showcase-orbit" aria-hidden="true"></div>
          {% if studio_image != blank %}
            <img class="bdc-showcase-bottle" src="{{ studio_image | image_url: width: 1100 }}" width="900" height="900" alt="{{ section.settings.showcase_image_alt | escape }}" loading="lazy">
          {% endif %}
          {% for block in section.blocks %}
            {% if block.type == 'hotspot' %}
              <div class="bdc-hotspot bdc-hotspot-{{ forloop.index }}" {{ block.shopify_attributes }}>
                <button type="button" aria-label="{{ block.settings.title | escape }}"></button>
                <span>
                  <b>{{ block.settings.title }}</b>
                  {{ block.settings.text }}
                </span>
              </div>
            {% endif %}
          {% endfor %}
        </div>
        <div class="bdc-showcase-side">
          <article class="bdc-glass bdc-spec-card" data-bdc-reveal>
            <span>{{ section.settings.showcase_right_label }}</span>
            <h3>{{ section.settings.showcase_right_heading }}</h3>
            <p>{{ section.settings.showcase_right_text }}</p>
          </article>
          <article class="bdc-glass bdc-spec-card" data-bdc-reveal>
            <span>{{ section.settings.showcase_right_label_2 }}</span>
            <h3>{{ section.settings.showcase_right_heading_2 }}</h3>
            <p>{{ section.settings.showcase_right_text_2 }}</p>
          </article>
        </div>
      </div>
    </section>

    <section class="bdc-notes bdc-padded" id="bdc-notes-{{ sid }}">
      <div class="bdc-container bdc-notes-layout">
        <div class="bdc-notes-image" data-bdc-reveal>
          {% if notes_image != blank %}
            <img src="{{ notes_image | image_url: width: 1100 }}" width="900" height="1100" alt="{{ section.settings.notes_image_alt | escape }}" loading="lazy">
          {% endif %}
        </div>
        <div>
          <p class="bdc-eyebrow" data-bdc-reveal>{{ section.settings.notes_eyebrow }}</p>
          <h2 class="bdc-section-title" data-bdc-reveal>{{ section.settings.notes_heading }}</h2>
          <p class="bdc-section-copy" data-bdc-reveal>{{ section.settings.notes_text }}</p>
          <div class="bdc-timeline">
            {% for block in section.blocks %}
              {% if block.type == 'note' %}
                <article class="bdc-note-row" data-bdc-reveal {{ block.shopify_attributes }}>
                  <span class="bdc-note-dot">{{ forloop.index }}</span>
                  <div class="bdc-note-content">
                    <h3>{{ block.settings.title }}</h3>
                    <div class="bdc-note-tags">
                      {% assign tags = block.settings.tags | split: '|' %}
                      {% for tag in tags %}
                        <span>{{ tag }}</span>
                      {% endfor %}
                    </div>
                  </div>
                </article>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
    </section>

    <section class="bdc-story">
      <div class="bdc-container bdc-story-wrap">
        <div>
          <p class="bdc-eyebrow" data-bdc-reveal>{{ section.settings.story_eyebrow }}</p>
          <h2 class="bdc-section-title" data-bdc-reveal>{{ section.settings.story_heading }}</h2>
          <p class="bdc-section-copy" data-bdc-reveal>{{ section.settings.story_text }}</p>
        </div>
        <div class="bdc-story-visual" aria-hidden="true">
          <div class="bdc-story-stage">
            <span class="bdc-story-glass"></span>
            <span class="bdc-story-liquid"></span>
            <span class="bdc-story-cap"></span>
            <span class="bdc-story-label">{{ section.settings.product_name }}</span>
          </div>
        </div>
      </div>
    </section>

    <section class="bdc-love bdc-padded">
      <div class="bdc-container">
        <p class="bdc-eyebrow" data-bdc-reveal>{{ section.settings.love_eyebrow }}</p>
        <h2 class="bdc-section-title" data-bdc-reveal>{{ section.settings.love_heading }}</h2>
        <div class="bdc-love-grid">
          <div class="bdc-love-media" data-bdc-reveal>
            {% if hero_image != blank %}<img src="{{ hero_image | image_url: width: 900 }}" width="800" height="800" alt="{{ section.settings.hero_image_alt | escape }}" loading="lazy">{% endif %}
          </div>
          <div class="bdc-love-list">
            {% assign love_items = section.settings.love_items | split: '|' %}
            {% for item in love_items %}
              <div class="bdc-love-item bdc-glass" data-bdc-reveal>
                <span>{{ forloop.index }}</span>
                <p>{{ item }}</p>
              </div>
            {% endfor %}
          </div>
          <div class="bdc-love-media" data-bdc-reveal>
            {% if notes_image != blank %}<img src="{{ notes_image | image_url: width: 900 }}" width="800" height="800" alt="{{ section.settings.notes_image_alt | escape }}" loading="lazy">{% endif %}
          </div>
        </div>
      </div>
    </section>

    <section class="bdc-compare bdc-padded">
      <div class="bdc-container">
        <div class="bdc-intro-row">
          <div>
            <p class="bdc-eyebrow" data-bdc-reveal>{{ section.settings.compare_eyebrow }}</p>
            <h2 class="bdc-section-title" data-bdc-reveal>{{ section.settings.compare_heading }}</h2>
          </div>
          <p class="bdc-section-copy" data-bdc-reveal>{{ section.settings.compare_text }}</p>
        </div>
        <div class="bdc-before-after" data-bdc-before-after>
          {% if compare_before_image != blank %}<img src="{{ compare_before_image | image_url: width: 1400 }}" width="1400" height="800" alt="{{ section.settings.compare_before_alt | escape }}" loading="lazy">{% endif %}
          {% if compare_after_image != blank %}<img class="bdc-ba-after" src="{{ compare_after_image | image_url: width: 1400 }}" width="1400" height="800" alt="{{ section.settings.compare_after_alt | escape }}" loading="lazy">{% endif %}
          <span class="bdc-ba-line"></span>
          <span class="bdc-ba-handle">Drag</span>
        </div>
      </div>
    </section>

    <section class="bdc-testimonials bdc-padded" id="bdc-reviews-{{ sid }}">
      <div class="bdc-container">
        <p class="bdc-eyebrow" data-bdc-reveal>{{ section.settings.reviews_eyebrow }}</p>
        <h2 class="bdc-section-title" data-bdc-reveal>{{ section.settings.reviews_heading }}</h2>
      </div>
      <div class="bdc-testimonial-track">
        {% for block in section.blocks %}
          {% if block.type == 'testimonial' %}
            <article class="bdc-glass bdc-testimonial" data-bdc-reveal {{ block.shopify_attributes }}>
              <div class="bdc-stars">{{ block.settings.rating }}</div>
              <p>{{ block.settings.review }}</p>
              <h3>{{ block.settings.name }}</h3>
              <small>{{ block.settings.meta }}</small>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </section>

    <section class="bdc-video-story bdc-padded">
      <div class="bdc-container">
        <div class="bdc-video-frame" {% if section.settings.video_fallback_image != blank %}style="--bdc-video-bg:url('{{ section.settings.video_fallback_image | image_url: width: 1600 }}')"{% endif %}>
          {% if section.settings.video_url != blank %}
            <video autoplay muted loop playsinline preload="metadata" {% if section.settings.video_fallback_image != blank %}poster="{{ section.settings.video_fallback_image | image_url: width: 1200 }}"{% endif %}>
              <source src="{{ section.settings.video_url | escape }}" type="video/mp4">
            </video>
          {% endif %}
          <div class="bdc-video-content">
            <span class="bdc-play-btn">▶</span>
            <h2 data-bdc-reveal>{{ section.settings.video_heading }}</h2>
            <p data-bdc-reveal>{{ section.settings.video_text }}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="bdc-usp bdc-padded">
      <div class="bdc-container">
        <p class="bdc-eyebrow" data-bdc-reveal>{{ section.settings.usp_eyebrow }}</p>
        <h2 class="bdc-section-title" data-bdc-reveal>{{ section.settings.usp_heading }}</h2>
        <div class="bdc-grid bdc-usp-grid">
          {% for block in section.blocks %}
            {% if block.type == 'usp' %}
              <article class="bdc-glass bdc-usp-card" data-bdc-reveal {{ block.shopify_attributes }}>
                <i>{{ block.settings.icon }}</i>
                <h3>{{ block.settings.title }}</h3>
                <p>{{ block.settings.text }}</p>
              </article>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </section>

    <section class="bdc-stats">
      <div class="bdc-container bdc-grid bdc-stats-grid">
        {% for block in section.blocks %}
          {% if block.type == 'stat' %}
            <div class="bdc-stat" data-bdc-reveal {{ block.shopify_attributes }}>
              <strong>{{ block.settings.value }}</strong>
              <span>{{ block.settings.label }}</span>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </section>

    <section class="bdc-gallery bdc-padded">
      <div class="bdc-container">
        <p class="bdc-eyebrow" data-bdc-reveal>{{ section.settings.gallery_eyebrow }}</p>
        <h2 class="bdc-section-title" data-bdc-reveal>{{ section.settings.gallery_heading }}</h2>
        <div class="bdc-masonry">
          {% for block in section.blocks %}
            {% if block.type == 'gallery' %}
              <figure class="bdc-gallery-item" data-bdc-reveal {{ block.shopify_attributes }}>
                {% if block.settings.image != blank %}
                  <img src="{{ block.settings.image | image_url: width: 900 }}" width="700" height="900" alt="{{ block.settings.alt | escape }}" loading="lazy">
                {% endif %}
                <figcaption>{{ block.settings.caption }}</figcaption>
              </figure>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </section>

    <section class="bdc-faq bdc-padded" id="bdc-faq-{{ sid }}">
      <div class="bdc-container bdc-faq-wrap">
        <div>
          <p class="bdc-eyebrow" data-bdc-reveal>{{ section.settings.faq_eyebrow }}</p>
          <h2 class="bdc-section-title" data-bdc-reveal>{{ section.settings.faq_heading }}</h2>
          <p class="bdc-section-copy" data-bdc-reveal>{{ section.settings.faq_text }}</p>
        </div>
        <div class="bdc-accordion">
          {% for block in section.blocks %}
            {% if block.type == 'faq' %}
              <article class="bdc-faq-item {% if forloop.first %}is-active{% endif %}" {{ block.shopify_attributes }}>
                <button type="button" class="bdc-faq-q">
                  <span>{{ block.settings.question }}</span>
                  <span>+</span>
                </button>
                <div class="bdc-faq-a"><p>{{ block.settings.answer }}</p></div>
              </article>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </section>

    <section class="bdc-final-cta" id="bdc-buy-{{ sid }}">
      <div class="bdc-final-orb" aria-hidden="true"></div>
      <div class="bdc-final-content">
        {% if studio_image != blank %}
          <img class="bdc-final-product" src="{{ studio_image | image_url: width: 800 }}" width="700" height="700" alt="{{ section.settings.showcase_image_alt | escape }}" loading="lazy">
        {% endif %}
        <p class="bdc-eyebrow" data-bdc-reveal>{{ section.settings.final_eyebrow }}</p>
        <h2 data-bdc-reveal>{{ section.settings.final_heading }}</h2>
        <p data-bdc-reveal>{{ section.settings.final_text }}</p>
        <div class="bdc-buttons">
          {% if product != blank %}
            <button class="bdc-btn bdc-btn-primary" type="button" data-bdc-buy-now>{{ section.settings.buy_now_label }}</button>
            <button class="bdc-btn bdc-btn-ghost" type="button" data-bdc-add>{{ section.settings.add_to_cart_label }}</button>
          {% else %}
            <a class="bdc-btn bdc-btn-primary" href="{{ primary_href }}">{{ section.settings.primary_label }}</a>
          {% endif %}
        </div>
      </div>
    </section>
  </main>

  {% if section.settings.show_sticky_atc and product != blank %}
    <aside class="bdc-sticky-atc" data-bdc-sticky-atc>
      <div class="bdc-sticky-inner">
        <div class="bdc-sticky-product">
          <div class="bdc-sticky-thumb">
            {% if studio_image != blank %}<img src="{{ studio_image | image_url: width: 160 }}" width="72" height="72" alt="{{ product.title | escape }}">{% endif %}
          </div>
          <div>
            <b>{{ product.title }}</b>
            <span>{{ section.settings.sticky_subtitle }}</span>
          </div>
        </div>
        {% unless product.has_only_default_variant %}
          <select class="bdc-select" data-bdc-variant aria-label="Variant">
            {% for variant in product.variants %}
              <option value="{{ variant.id }}" data-price="{{ variant.price | money }}" {% if variant == current_variant %}selected{% endif %}>{{ variant.title }}</option>
            {% endfor %}
          </select>
        {% else %}
          <input type="hidden" value="{{ current_variant.id }}" data-bdc-variant-id>
        {% endunless %}
        <input class="bdc-qty" type="number" min="1" max="10" value="1" data-bdc-qty aria-label="Quantity">
        <div class="bdc-sticky-price" data-bdc-price>{{ current_variant.price | money }}</div>
        <button class="bdc-btn bdc-btn-primary" type="button" data-bdc-add>{{ section.settings.add_to_cart_label }}</button>
      </div>
    </aside>
  {% endif %}

  {% if section.settings.show_announcement %}
    <aside class="bdc-announcement" data-bdc-announcement>
      <button type="button" data-bdc-close-announcement aria-label="Close">×</button>
      <b>{{ section.settings.announcement_heading }}</b>
      <p>{{ section.settings.announcement_text }}</p>
      <span>{{ section.settings.announcement_stock }}</span>
    </aside>
  {% endif %}
</section>

<style>
  .bdc-{{ sid }} {
    --bg: {{ section.settings.bg_color }};
    --bg-2: {{ section.settings.bg_2_color }};
    --surface: #1B1B1B;
    --gold: {{ section.settings.gold_color }};
    --gold-light: {{ section.settings.gold_light_color }};
    --gold-dark: #A97C2D;
    --ruby: {{ section.settings.ruby_color }};
    --crimson: #A12234;
    --white: {{ section.settings.text_color }};
    --muted: {{ section.settings.muted_color }};
    --readable-muted: color-mix(in srgb, var(--muted) 72%, var(--white));
    --border: rgba(255,255,255,.08);
    --card: rgba(255,255,255,.035);
    --shadow: 0 30px 90px rgba(0,0,0,.55);
    --radius: {{ section.settings.card_radius }}px;
    --ease: cubic-bezier(.22,1,.36,1);
    --heading: "Playfair Display", serif;
    --body: "Inter", sans-serif;
    --button: "Poppins", sans-serif;
    position: relative;
    display: block;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(circle at 50% -10%, color-mix(in srgb, var(--gold) 18%, transparent), transparent 38%),
      radial-gradient(circle at 88% 16%, color-mix(in srgb, var(--ruby) 16%, transparent), transparent 28%),
      var(--bg);
    color: var(--white);
    font-family: var(--body);
    line-height: 1.55;
  }
  .bdc-{{ sid }} * { box-sizing: border-box; }
  .bdc-{{ sid }} a { color: inherit; text-decoration: none; }
  .bdc-{{ sid }} img, .bdc-{{ sid }} video { display: block; max-width: 100%; }
  .bdc-{{ sid }} button, .bdc-{{ sid }} input, .bdc-{{ sid }} select { font: inherit; color: inherit; }
  .bdc-{{ sid }} .bdc-container { width: min(1180px, calc(100% - 40px)); margin-inline: auto; }
  .bdc-{{ sid }} .bdc-grid { display: grid; gap: 24px; }
  .bdc-{{ sid }} .bdc-eyebrow {
    font-family: var(--button);
    font-size: 12px;
    letter-spacing: .24em;
