<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>
<script>
  (() => {
    const root = document.getElementById('BigDaddyCustom-{{ sid }}');
    if (!root || root.dataset.bdcReady === 'true') return;
    root.dataset.bdcReady = 'true';
    root.classList.add('bdc-js');
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const clamp = (num, min, max) => Math.min(Math.max(num, min), max);

    const story = root.querySelector('[data-bdc-story]');
    const storyLiquid = root.querySelector('[data-bdc-story-liquid]');
    if (story && storyLiquid && window.gsap && window.ScrollTrigger) {
      gsap.registerPlugin(ScrollTrigger);

      if (prefersReduced) {
        gsap.set(storyLiquid, { scaleY: 1 });
      } else {
        gsap.fromTo(storyLiquid,
          { scaleY: 0 },
          {
            scaleY: 1,
            ease: 'none',
            scrollTrigger: {
              trigger: story,
              start: 'top 78%',
              end: 'bottom 30%',
              scrub: .55,
              invalidateOnRefresh: true
            }
          }
        );
      }
    }

    const stickyAtc = root.querySelector('[data-bdc-sticky-atc]');
    const onScroll = () => {
      const rect = root.getBoundingClientRect();
      const inSectionY = Math.max(0, -rect.top);
      stickyAtc?.classList.toggle('is-visible', inSectionY > window.innerHeight * .75 && rect.bottom > window.innerHeight);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();


    const revealEls = root.querySelectorAll('[data-bdc-reveal]');
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { rootMargin: '0px 0px -12% 0px' });
      revealEls.forEach(el => observer.observe(el));
      setTimeout(() => revealEls.forEach(el => el.classList.add('is-visible')), 1500);
    } else {
      revealEls.forEach(el => el.classList.add('is-visible'));
    }

    const tiltWrap = root.querySelector('[data-bdc-tilt-wrap]');
    const tilt = root.querySelector('[data-bdc-tilt]');
    if (tiltWrap && tilt && !prefersReduced) {
      tiltWrap.addEventListener('pointermove', event => {
        const rect = tiltWrap.getBoundingClientRect();
        const x = (event.clientX - rect.left) / rect.width - .5;
        const y = (event.clientY - rect.top) / rect.height - .5;
        tilt.style.transform = `rotateY(${x * 14}deg) rotateX(${-y * 10}deg) translateY(-10px)`;
      });
      tiltWrap.addEventListener('pointerleave', () => { tilt.style.transform = ''; });
    }

    root.querySelectorAll('.bdc-faq-item').forEach(item => {
      const answer = item.querySelector('.bdc-faq-a');
      const setHeight = () => { if (answer) answer.style.height = item.classList.contains('is-active') ? answer.scrollHeight + 'px' : '0px'; };
      setHeight();
      item.querySelector('.bdc-faq-q')?.addEventListener('click', () => {
        const isActive = item.classList.contains('is-active');
        root.querySelectorAll('.bdc-faq-item').forEach(other => {
          other.classList.remove('is-active');
          const panel = other.querySelector('.bdc-faq-a');
          if (panel) panel.style.height = '0px';
        });
        if (!isActive) {
          item.classList.add('is-active');
          setHeight();
        }
      });
    });

    const beforeAfter = root.querySelector('[data-bdc-before-after]');
    if (beforeAfter) {
      const after = beforeAfter.querySelector('.bdc-ba-after');
      const line = beforeAfter.querySelector('.bdc-ba-line');
      const handle = beforeAfter.querySelector('.bdc-ba-handle');
      const setPos = clientX => {
        const rect = beforeAfter.getBoundingClientRect();
        const pct = clamp(((clientX - rect.left) / rect.width) * 100, 3, 97);
        if (after) after.style.clipPath = `inset(0 0 0 ${pct}%)`;
        if (line) line.style.left = pct + '%';
        if (handle) handle.style.left = pct + '%';
      };
      beforeAfter.addEventListener('pointermove', event => setPos(event.clientX));
      beforeAfter.addEventListener('pointerdown', event => setPos(event.clientX));
    }

    const variantSelect = root.querySelector('[data-bdc-variant]');
    const currentPriceElements = root.querySelectorAll('[data-bdc-current-price]');
    const comparePriceElements = root.querySelectorAll('[data-bdc-compare-price]');
    const mrpRowElements = root.querySelectorAll('[data-bdc-mrp-row]');
    const discountBadgeElements = root.querySelectorAll('[data-bdc-discount-badge]');

    const updateDisplayedPricing = (selectedOption) => {
      if (!selectedOption) return;

      const currentPrice = selectedOption.dataset.price || '';
      const comparePrice = selectedOption.dataset.comparePrice || '';
      const discountPercent = Number(selectedOption.dataset.discountPercent || 0);

      currentPriceElements.forEach(element => {
        if (currentPrice) element.textContent = currentPrice;
      });

      comparePriceElements.forEach(element => {
        element.textContent = comparePrice;
      });

      mrpRowElements.forEach(element => {
        element.classList.toggle('is-hidden', !comparePrice);
      });

      discountBadgeElements.forEach(element => {
        element.textContent = discountPercent > 0 ? `${discountPercent}% OFF` : '';
        element.classList.toggle('is-hidden', discountPercent <= 0);
      });
    };

    variantSelect?.addEventListener('change', () => {
      updateDisplayedPricing(variantSelect.selectedOptions[0]);
    });

    root.querySelectorAll('[data-bdc-copy-code]').forEach(button => {
      button.addEventListener('click', async () => {
        const code = button.dataset.code || '';
        const actionLabel = button.querySelector('[data-bdc-copy-action]');
        if (!code) return;

        try {
          if (navigator.clipboard && window.isSecureContext) {
            await navigator.clipboard.writeText(code);
          } else {
            const temporaryInput = document.createElement('textarea');
            temporaryInput.value = code;
            temporaryInput.setAttribute('readonly', '');
            temporaryInput.style.position = 'fixed';
            temporaryInput.style.opacity = '0';
            document.body.appendChild(temporaryInput);
            temporaryInput.select();
            document.execCommand('copy');
            temporaryInput.remove();
          }

          button.classList.add('is-copied');
          if (actionLabel) actionLabel.textContent = button.dataset.copiedLabel || 'Copied!';

          window.setTimeout(() => {
            button.classList.remove('is-copied');
            if (actionLabel) actionLabel.textContent = button.dataset.copyLabel || 'Copy code';
          }, 1600);
        } catch (copyError) {
          console.error('Discount code copy failed:', copyError);
        }
      });
    });

    const getVariantId = () => variantSelect ? variantSelect.value : root.querySelector('[data-bdc-variant-id]')?.value || '{{ current_variant.id }}';
    const getQty = () => Math.max(1, parseInt(root.querySelector('[data-bdc-qty]')?.value || '1', 10));
    async function addToCart(redirect) {
      const variantId = getVariantId();
      if (!variantId) return;
      const buttons = root.querySelectorAll('[data-bdc-add], [data-bdc-buy-now]');
      buttons.forEach(button => {
        button.disabled = true;
        button.dataset.oldText = button.textContent;
        button.textContent = 'Adding...';
      });
      try {
        const response = await fetch('{{ routes.cart_add_url }}.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ id: Number(variantId), quantity: getQty() })
        });
        if (!response.ok) throw new Error('Cart add failed');
        document.dispatchEvent(new CustomEvent('cart:refresh'));
        document.dispatchEvent(new CustomEvent('cart-drawer:open'));
        if (redirect) {
          window.location.href = '/checkout';
          return;
        }
        buttons.forEach(button => { button.textContent = 'Added'; });
        setTimeout(() => buttons.forEach(button => {
          button.disabled = false;
          button.textContent = button.dataset.oldText || '{{ section.settings.add_to_cart_label }}';
        }), 1100);
      } catch (error) {
        console.error(error);
        buttons.forEach(button => {
          button.disabled = false;
          button.textContent = 'Try Again';
        });
      }
    }
    root.querySelectorAll('[data-bdc-add]').forEach(button => button.addEventListener('click', () => addToCart(false)));
    root.querySelectorAll('[data-bdc-buy-now]').forEach(button => button.addEventListener('click', () => addToCart(true)));

  })();
</script>

