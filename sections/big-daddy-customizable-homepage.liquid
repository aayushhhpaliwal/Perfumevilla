<script>
  (() => {
    const root = document.getElementById('BigDaddyCustom-{{ sid }}');
    if (!root || root.dataset.bdcReady === 'true') return;
    root.dataset.bdcReady = 'true';
    root.classList.add('bdc-js');
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const clamp = (num, min, max) => Math.min(Math.max(num, min), max);

    const preloader = root.querySelector('[data-bdc-preloader]');
    if (preloader) {
      const bar = root.querySelector('[data-bdc-loader-bar]');
      const percent = root.querySelector('[data-bdc-loader-percent]');
      let progress = 0;
      const interval = setInterval(() => {
        progress = clamp(progress + Math.floor(Math.random() * 12) + 8, 0, 100);
        if (bar) bar.style.width = progress + '%';
        if (percent) percent.textContent = progress + '%';
        if (progress >= 100) {
          clearInterval(interval);
          setTimeout(() => preloader.classList.add('is-hidden'), 350);
        }
      }, 90);
    }

    const header = root.querySelector('[data-bdc-header]');
    const stickyAtc = root.querySelector('[data-bdc-sticky-atc]');
    const announcement = root.querySelector('[data-bdc-announcement]');
    const onScroll = () => {
      const rect = root.getBoundingClientRect();
      const inSectionY = Math.max(0, -rect.top);
      header?.classList.toggle('is-scrolled', inSectionY > 40);
      stickyAtc?.classList.toggle('is-visible', inSectionY > window.innerHeight * .75 && rect.bottom > window.innerHeight);
      if (inSectionY > window.innerHeight * .35) announcement?.classList.add('is-visible');
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    root.querySelector('[data-bdc-close-announcement]')?.addEventListener('click', () => announcement?.remove());

    const revealEls = root.querySelectorAll('[data-bdc-reveal]');
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { rootMargin: '0px 0px -12% 0px' });
      revealEls.forEach(el => observer.observe(el));
      setTimeout(() => revealEls.forEach(el => el.classList.add('is-visible')), 1500);
    } else {
      revealEls.forEach(el => el.classList.add('is-visible'));
    }

    const tiltWrap = root.querySelector('[data-bdc-tilt-wrap]');
    const tilt = root.querySelector('[data-bdc-tilt]');
    if (tiltWrap && tilt && !prefersReduced) {
      tiltWrap.addEventListener('pointermove', event => {
        const rect = tiltWrap.getBoundingClientRect();
        const x = (event.clientX - rect.left) / rect.width - .5;
        const y = (event.clientY - rect.top) / rect.height - .5;
        tilt.style.transform = `rotateY(${x * 14}deg) rotateX(${-y * 10}deg) translateY(-10px)`;
      });
      tiltWrap.addEventListener('pointerleave', () => { tilt.style.transform = ''; });
    }

    root.querySelectorAll('.bdc-faq-item').forEach(item => {
      const answer = item.querySelector('.bdc-faq-a');
      const setHeight = () => { if (answer) answer.style.height = item.classList.contains('is-active') ? answer.scrollHeight + 'px' : '0px'; };
      setHeight();
      item.querySelector('.bdc-faq-q')?.addEventListener('click', () => {
        const isActive = item.classList.contains('is-active');
        root.querySelectorAll('.bdc-faq-item').forEach(other => {
          other.classList.remove('is-active');
          const panel = other.querySelector('.bdc-faq-a');
          if (panel) panel.style.height = '0px';
        });
        if (!isActive) {
          item.classList.add('is-active');
          setHeight();
        }
      });
    });

    const beforeAfter = root.querySelector('[data-bdc-before-after]');
    if (beforeAfter) {
      const after = beforeAfter.querySelector('.bdc-ba-after');
      const line = beforeAfter.querySelector('.bdc-ba-line');
      const handle = beforeAfter.querySelector('.bdc-ba-handle');
      const setPos = clientX => {
        const rect = beforeAfter.getBoundingClientRect();
        const pct = clamp(((clientX - rect.left) / rect.width) * 100, 3, 97);
        if (after) after.style.clipPath = `inset(0 0 0 ${pct}%)`;
        if (line) line.style.left = pct + '%';
        if (handle) handle.style.left = pct + '%';
      };
      beforeAfter.addEventListener('pointermove', event => setPos(event.clientX));
      beforeAfter.addEventListener('pointerdown', event => setPos(event.clientX));
    }

    const variantSelect = root.querySelector('[data-bdc-variant]');
    const price = root.querySelector('[data-bdc-price]');
    variantSelect?.addEventListener('change', () => {
      const selected = variantSelect.selectedOptions[0];
      if (price && selected?.dataset.price) price.textContent = selected.dataset.price;
    });

    const getVariantId = () => variantSelect ? variantSelect.value : root.querySelector('[data-bdc-variant-id]')?.value || '{{ current_variant.id }}';
    const getQty = () => Math.max(1, parseInt(root.querySelector('[data-bdc-qty]')?.value || '1', 10));
    async function addToCart(redirect) {
      const variantId = getVariantId();
      if (!variantId) return;
      const buttons = root.querySelectorAll('[data-bdc-add], [data-bdc-buy-now]');
      buttons.forEach(button => {
        button.disabled = true;
        button.dataset.oldText = button.textContent;
        button.textContent = 'Adding...';
      });
      try {
        const response = await fetch('{{ routes.cart_add_url }}.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ id: Number(variantId), quantity: getQty() })
        });
        if (!response.ok) throw new Error('Cart add failed');
        document.dispatchEvent(new CustomEvent('cart:refresh'));
        document.dispatchEvent(new CustomEvent('cart-drawer:open'));
        if (redirect) {
          window.location.href = '/checkout';
          return;
        }
        buttons.forEach(button => { button.textContent = 'Added'; });
        setTimeout(() => buttons.forEach(button => {
          button.disabled = false;
          button.textContent = button.dataset.oldText || '{{ section.settings.add_to_cart_label }}';
        }), 1100);
      } catch (error) {
        console.error(error);
        buttons.forEach(button => {
          button.disabled = false;
          button.textContent = 'Try Again';
        });
      }
    }
    root.querySelectorAll('[data-bdc-add]').forEach(button => button.addEventListener('click', () => addToCart(false)));
    root.querySelectorAll('[data-bdc-buy-now]').forEach(button => button.addEventListener('click', () => addToCart(true)));

    const canvas = root.querySelector('[data-bdc-particles]');
    if (canvas && !prefersReduced) {
      const ctx = canvas.getContext('2d');
      let particles = [];
      const resize = () => {
        const rect = root.querySelector('.bdc-hero')?.getBoundingClientRect();
        const width = window.innerWidth;
        const height = Math.max(window.innerHeight, rect?.height || window.innerHeight);
        canvas.width = width * devicePixelRatio;
        canvas.height = height * devicePixelRatio;
        canvas.style.width = width + 'px';
        canvas.style.height = height + 'px';
        ctx.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
        particles = Array.from({ length: Math.min(90, Math.floor(width / 16)) }, () => ({
          x: Math.random() * width,
          y: Math.random() * height,
          r: Math.random() * 1.6 + .35,
          vx: (Math.random() - .5) * .22,
          vy: -Math.random() * .24 - .04,
          a: Math.random() * .45 + .12
        }));
      };
      const draw = () => {
        const width = canvas.clientWidth;
        const height = canvas.clientHeight;
        ctx.clearRect(0, 0, width, height);
        particles.forEach(particle => {
          particle.x += particle.vx;
          particle.y += particle.vy;
          if (particle.y < -20) {
            particle.y = height + 20;
            particle.x = Math.random() * width;
          }
          const grad = ctx.createRadialGradient(particle.x, particle.y, 0, particle.x, particle.y, particle.r * 8);
          grad.addColorStop(0, `rgba(228,200,138,${particle.a})`);
          grad.addColorStop(1, 'rgba(228,200,138,0)');
          ctx.fillStyle = grad;
          ctx.beginPath();
          ctx.arc(particle.x, particle.y, particle.r * 8, 0, Math.PI * 2);
          ctx.fill();
        });
        requestAnimationFrame(draw);
      };
      window.addEventListener('resize', resize);
      resize();
      draw();
    }
  })();
</script>

